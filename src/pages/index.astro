---
import Header from "@/components/Header.astro";
import { URL_BASE } from "@/config";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div
    class="min-h-screen flex flex-col bg-right lg:bg-center lg:bg-cover"
    style={`background-image: url(${URL_BASE}/backgrounds/bg_home.webp);`}
  >
    <Header />
    <main
      class="w-7xl mx-auto max-w-full p-4 md:p-6 flex-1 flex flex-col lg:flex-row h-full"
    >
      <div class="w-full lg:w-1/2 flex flex-col items-start">
        <h1 class="text-4xl lg:text-6xl font-bold text-orange-abbott mb-2">
          <span class="font-light">CASOS</span>
          <span
            class="block rounded-full"
            style="font-size:1.15em;">DAYAMINERAL</span
          >
        </h1>
        <p class="mt-4 text-2xl xs:text-3xl text-black">
          Seleccione en cada caso el beneficio que aporta Dayamineral.
        </p>
        <a
          class="my-8 text-2xl lg:text-3xl text-white font-bold py-3 px-6 rounded-full flex items-center bg-morado-abbott hover:scale-105 transition-transform duration-300"
          href={`${URL_BASE}/quiz`}
        >
          COMENZAR
        </a>
      </div>
      <div class="w-full lg:w-1/2 flex flex-col items-end justify-end flex-1">
        <div class="flex">
          <p class="text-xs text-white">
            USO EXCLUSIVO PARA PROFESIONALES MÉDICOS <b>CAC-26-0604</b>
          </p>
        </div>
      </div>
    </main>
  </div>
</Layout>
